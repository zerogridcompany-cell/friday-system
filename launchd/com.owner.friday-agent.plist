		<key>CLAUDE_BIN</key>
		<string>/Users/owner/bin/claude-ssh</string>
		<key>PATH</key>
		<string>/Users/owner/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
