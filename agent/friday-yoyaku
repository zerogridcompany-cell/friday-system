#!/usr/bin/env python3
"""フライデーの知らせ・電話を予約する（plan/<日付>.json に足す→ friday-tick が時刻に送る／かける）2026-10-31
使い方: friday-yoyaku "YYYY-MM-DD HH:MM" "用件" [--call] [--retry 3] [--id 名前]
  --call   電話でかける（出んかったら --retry 回まで5分おきにかけ直し・最後は LINE）
  例: friday-yoyaku "2026-11-01 06:30" "おはようございます。お出かけの日です" --call --retry 3
毎朝の決まった電話は ~/owner-kotoba/friday/denwa_teiki.json（skip に日付を入れると、その日は休み）"""
import sys, json, os, re, subprocess, datetime
a = sys.argv[1:]
if len(a) < 2: print(__doc__); sys.exit(1)
at = datetime.datetime.strptime(a[0], "%Y-%m-%d %H:%M"); text = a[1]
call = "--call" in a; retry = int(a[a.index("--retry") + 1]) if "--retry" in a else (3 if call else 0)
iid = a[a.index("--id") + 1] if "--id" in a else "yoyaku_" + at.strftime("%H%M") + ("_call" if call else "")
# 11/11 『◯時ご出発』『◯時発』をカレンダーと枝06に照らす。違えば正しい時刻に直してから予約（送る時も friday-tick がもう一度照らす）
sys.path.insert(0, os.path.expanduser("~/bin"))
try:
    from friday_shougou import shougou, kiroku
    sg = shougou(text, at.date()); kiroku("yoyaku", iid, sg)
    if sg["status"] == "hold": print("⛔ 照合で止めた（予約せん）：" + " / ".join(sg["notes"])); sys.exit(2)
    if sg["status"] == "fixed": print("✏️ 時刻を直した：" + " / ".join(sg["notes"])); text = sg["text"]
except SystemExit: raise
except Exception as e: print(f"⚠︎ 照合できんかった（{e}）")
F = os.path.expanduser("~/owner-kotoba/friday/plan"); os.makedirs(F, exist_ok=True)
p = f"{F}/{at:%Y%m%d}.json"; pl = json.load(open(p)) if os.path.exists(p) else {"items": []}
pl["items"] = [x for x in pl["items"] if x["id"] != iid or x.get("status")]
pl["items"].append({"id": iid, "at": at.strftime("%H:%M"), "text": text, "links": [], "eta": None, "status": None,
                    "src": "yoyaku", "call": call, "retry": retry})
pl["items"].sort(key=lambda x: x["at"]); json.dump(pl, open(p, "w"), ensure_ascii=False, indent=1)
other = "project-j-macmini:owner-kotoba/friday/plan/" if not os.path.isdir("/Users/owner") else "owner@YOUR_TAILSCALE_IP:owner-kotoba/friday/plan/"
ssh = [] if not os.path.isdir("/Users/owner") else ["-i", os.path.expanduser("~/.ssh/id_ed25519_hermes_macbook_obsidian")]
try:  # 11/09 Air がオフでも予約は通す
    subprocess.run(["scp", "-q", "-o", "ConnectTimeout=5"] + ssh + [p, other], capture_output=True, timeout=30)
except Exception: pass
print(f"予約した {at:%m/%d %H:%M} {'📞電話' if call else 'LINE'} {iid}")
