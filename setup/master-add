#!/usr/bin/env python3
"""会話で分かった持ち主の新しい事を枝に1行足す。使い方：master-add <枝番号 01〜08> "<事実>" [出所]
同じ行がもうあれば足さない。06 は「## 済」より上に足す。記録の置き場は FRIDAY_KOTOBA（無ければ ~/owner-kotoba）"""
import datetime, glob, os, sys
K = os.environ.get("FRIDAY_KOTOBA", os.path.expanduser("~/owner-kotoba"))
if len(sys.argv) < 3: sys.exit(__doc__)
no, fact = sys.argv[1].zfill(2), sys.argv[2].strip()
src = sys.argv[3] if len(sys.argv) > 3 else "フライデー"
fs = glob.glob(f"{K}/master/枝/{no}_*.md")
if not fs: sys.exit(f"枝 {no} が無い。先に friday-kikitori init")
p = fs[0]; s = open(p, encoding="utf-8").read()
if fact[:40] in s: sys.exit(0)
line = f"- {fact}（{src}・{datetime.date.today()}）"
if "## 済" in s: s = s.replace("## 済", line + "\n\n## 済", 1)
elif "## 足した事（新しい順）" in s: s = s.replace("## 足した事（新しい順）", "## 足した事（新しい順）\n" + line, 1)
else: s = s.rstrip("\n") + "\n" + line + "\n"
open(p, "w", encoding="utf-8").write(s); print("足した →", p)
